# Copy to .env and edit.

# The public TLS port of the broker on this host (a non-standard port; open it in the firewall).
# It must match YULE_BROKER_PORT in firmware/include/secrets.h.
MQTT_TLS_PORT=18883

# Directory holding fullchain.pem and privkey.pem for the broker's public name. Files must be readable by
# uid 1883 (the mosquitto user in the container).
CERT_DIR=./certs

# Host port, on loopback, that the reverse proxy forwards to the Yule server.
SERVER_HTTP_PORT=8080
