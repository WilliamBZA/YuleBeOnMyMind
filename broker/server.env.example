# Copy to server.env and edit. Never commit server.env.
# ASP.NET Core reads these as nested configuration: Yule__Admin__PasswordHash is Yule:Admin:PasswordHash.

# The administrator login. Generate the hash with:  dotnet run --project ../server/src/Yule.Server -- hash-password
Yule__Admin__PasswordHash=

# The service account the server uses on the internal listener (created in README step 4).
Yule__Broker__Username=yule-server
Yule__Broker__Password=

# The server's public address, used to build firmware download URLs in release manifests.
Yule__PublicBaseUrl=https://yule.williamb.net

# Public keys (PEM, ECDSA P-256) that firmware releases must be signed with. Up to two, to allow key rotation.
# Newlines may be written as \n.
Yule__ReleasePublicKeys__0=
#Yule__ReleasePublicKeys__1=
