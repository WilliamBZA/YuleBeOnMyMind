@page "/groups/{id}/remove"
@model RemoveModel
@{
    ViewData["Title"] = "Delete " + Model.Group.Name;
}

<h1>Delete @Model.Group.Name?</h1>
<p class="lead"><span class="id">@Model.Group.Id</span></p>

<div class="card">
    <p>
        @if (Model.Group.Members.Count == 0)
        {
            <text>This group has no members.</text>
        }
        else
        {
            <text>
                Its @Display.Plural(Model.Group.Members.Count, "member") (@string.Join(", ", Model.Group.Members.Select(m => m.Label)))
                stop sending to it and receiving its presses within a few seconds. The devices themselves stay registered.
            </text>
        }
    </p>
    <form method="post" class="inline">
        <button type="submit" class="danger">Delete group</button>
        <a class="button secondary" asp-page="/Groups/Details" asp-route-id="@Model.Group.Id">Cancel</a>
    </form>
</div>
